namespace CodegenMatrix;

table Child { name:string; }

union Only { Child }
union Alias { M1: Child, M2: Child }

enum Flags:ubyte (bit_flags) { A = 0, B = 1, C = 3 }
enum Kind:ubyte { Low, High }

struct Shadow {
  fbb:int;
  state:int;
}

table UnionOnly {
  item:Only;
}

table AliasHolder {
  a:Alias;
}

table Fields {
  state:int;
  serializer:int;
  i:int;
  fbb:int;
  flags:Flags = C;
}

table Optional {
  x:int = null;
  e:Kind = null;
}

table ShadowTable {
  s:Shadow;
}

table Aligned {
  data:[ubyte] (force_align: 16);
}

root_type UnionOnly;
