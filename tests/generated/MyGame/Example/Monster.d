    static bool verify(ref Verifier v, uint pos) @nogc nothrow
    {
        if (!v.verifyTableStart(pos)) return false;
        if (!v.verifyField(pos, 4, 32, 8, false)) return false;
        if (!v.verifyField(pos, 6, 2, 2, false)) return false;
        if (!v.verifyField(pos, 8, 2, 2, false)) return false;
        if (!v.verifyString(pos, 10, true)) return false;
        if (!v.verifyVectorOfData(pos, 14, 1, false)) return false;
        if (!v.verifyField(pos, 16, 1, 1, false)) return false;
        if (!v.verifyField(pos, 18, 1, 1, false)) return false;
        if (!v.verifyUnion(pos, 18, 20, &MyGame.Example.Any.verifyAny, false)) return false;
        if (!v.verifyVectorOfData(pos, 22, 4, false)) return false;
        if (!v.verifyVectorOfStrings(pos, 24, false)) return false;
        if (!v.verifyVectorOfTables(pos, 26, &Monster.verify, false)) return false;
        if (!v.verifyTable(pos, 28, &Monster.verify, false)) return false;
        if (!v.verifyVectorOfData(pos, 30, 1, false)) return false;
        if (!v.verifyNestedBuffer(pos, 30, "", &Monster.verify, false)) return false;
        if (!v.verifyTable(pos, 32, &MyGame.Example.Stat.Stat.verify, false)) return false;
        if (!v.verifyField(pos, 34, 1, 1, false)) return false;
        if (!v.verifyField(pos, 36, 4, 4, false)) return false;
        if (!v.verifyField(pos, 38, 4, 4, false)) return false;
        if (!v.verifyField(pos, 40, 8, 8, false)) return false;
        if (!v.verifyField(pos, 42, 8, 8, false)) return false;
        if (!v.verifyField(pos, 44, 4, 4, false)) return false;
        if (!v.verifyField(pos, 46, 4, 4, false)) return false;
        if (!v.verifyField(pos, 48, 8, 8, false)) return false;
        if (!v.verifyField(pos, 50, 8, 8, false)) return false;
        if (!v.verifyVectorOfData(pos, 52, 1, false)) return false;
        if (!v.verifyField(pos, 54, 4, 4, false)) return false;
        if (!v.verifyField(pos, 56, 4, 4, false)) return false;
        if (!v.verifyField(pos, 58, 4, 4, false)) return false;
        if (!v.verifyVectorOfStrings(pos, 60, false)) return false;
        if (!v.verifyVectorOfData(pos, 62, 8, false)) return false;
        if (!v.verifyVectorOfData(pos, 64, 1, false)) return false;
        if (!v.verifyVectorOfData(pos, 66, 4, false)) return false;
        if (!v.verifyVectorOfData(pos, 68, 8, false)) return false;
        if (!v.verifyVectorOfData(pos, 70, 8, false)) return false;
        if (!v.verifyTable(pos, 72, &MyGame.InParentNamespace.InParentNamespace.verify, false)) return false;
        if (!v.verifyVectorOfTables(pos, 74, &MyGame.Example.Referrable.Referrable.verify, false)) return false;
        if (!v.verifyField(pos, 76, 8, 8, false)) return false;
        if (!v.verifyVectorOfData(pos, 78, 8, false)) return false;
        if (!v.verifyVectorOfTables(pos, 80, &MyGame.Example.Referrable.Referrable.verify, false)) return false;
        if (!v.verifyField(pos, 82, 8, 8, false)) return false;
        if (!v.verifyVectorOfData(pos, 84, 8, false)) return false;
        if (!v.verifyField(pos, 86, 8, 8, false)) return false;
        if (!v.verifyVectorOfData(pos, 88, 8, false)) return false;
        if (!v.verifyField(pos, 90, 1, 1, false)) return false;
        if (!v.verifyUnion(pos, 90, 92, &MyGame.Example.AnyUniqueAliases.verifyAnyUniqueAliases, false)) return false;
        if (!v.verifyField(pos, 94, 1, 1, false)) return false;
        if (!v.verifyUnion(pos, 94, 96, &MyGame.Example.AnyAmbiguousAliases.verifyAnyAmbiguousAliases, false)) return false;
        if (!v.verifyVectorOfData(pos, 98, 1, false)) return false;
        if (!v.verifyField(pos, 100, 1, 1, false)) return false;
        if (!v.verifyVectorOfData(pos, 102, 1, false)) return false;
        if (!v.verifyNestedBuffer(pos, 102, "", &Monster.verify, false)) return false;
        if (!v.verifyVectorOfTables(pos, 104, &MyGame.Example.Stat.Stat.verify, false)) return false;
        if (!v.verifyField(pos, 106, 4, 2, false)) return false;
        if (!v.verifyField(pos, 108, 8, 8, false)) return false;
        if (!v.verifyField(pos, 110, 8, 8, false)) return false;
        if (!v.verifyField(pos, 112, 4, 4, false)) return false;
        if (!v.verifyField(pos, 114, 4, 4, false)) return false;
        if (!v.verifyField(pos, 116, 4, 4, false)) return false;
        if (!v.verifyField(pos, 118, 4, 4, false)) return false;
        if (!v.verifyField(pos, 120, 4, 4, false)) return false;
        if (!v.verifyField(pos, 122, 4, 4, false)) return false;
        if (!v.verifyField(pos, 124, 4, 4, false)) return false;
        if (!v.verifyField(pos, 126, 8, 8, false)) return false;
