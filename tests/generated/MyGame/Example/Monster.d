    static bool verifyMonsterBuffer(const(ubyte)[] buf, bool sizePrefixed = false)
        @nogc nothrow
    {
        auto verifier = Verifier(buf);
        return verifier.verifyBuffer("MONS", sizePrefixed, &verify);
    }

